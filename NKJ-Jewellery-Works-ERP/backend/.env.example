# Copy this file to .env and replace each CHANGE_ME value before running.
DB_URL=jdbc:postgresql://localhost:5432/nkj_billing
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
SERVER_PORT=8086
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

ADMIN_USERNAME=admin2026
ADMIN_PASSWORD=CHANGE_ME
# Generate a unique Base32 secret (A-Z and 2-7, 16-64 characters).
TOTP_SECRET=GENERATE_UNIQUE_BASE32_SECRET

# Exact local Vite origins. Add your deployed frontend origin only when needed.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Set the salt/hash generated for a fresh six-digit invoice PIN.
INVOICE_PIN_SALT=CHANGE_ME
INVOICE_PIN_HASH=CHANGE_ME

# First-time owner setup email OTP delivery.
FIRST_SETUP_EMAIL=rabhisek2030@gmail.com

# Recommended for Render Free: EmailJS HTTPS API (port 443).
# Connect a Gmail service and configure a template with To Email = {{to_email}}.
# Template body variables: {{shop_name}}, {{otp_code}}, {{expiry_minutes}}.
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=

# SMTP fallback for local development or paid hosts that allow outbound SMTP.
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional: authorized Anandabazar Patrika daily-rate adapter.
ABP_RATE_FEED_ENABLED=false
ABP_RATE_FEED_URL=
ABP_RATE_FEED_API_KEY=

# Jewellery design uploads.
# Use a persistent mounted volume in production; do not use ephemeral/container-only storage.
DESIGNS_UPLOAD_DIR=./uploads/designs
DESIGNS_MOBILE_UPLOAD_BASE_URL=
# LOCAL DEVELOPMENT ONLY: allow temporary QR links over private Wi-Fi IPv4 HTTP.
NKJ_DESIGNS_MOBILE_UPLOAD_ALLOW_PRIVATE_HTTP=false
